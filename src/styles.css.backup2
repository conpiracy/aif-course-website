/* AIF Course - Teleprompter Presentation */
@import "tailwindcss";

:root {
  --bg: #000000;
  --text-very-dim: #333333;
  --text-dim: #999999;
  --text-read: #ffffff;
  --highlight-bg: #ffffff;
  --highlight-text: #000000;
  --highlight-glow: rgba(251, 191, 36, 0.3);
  --border: #1a1a1a;
  --card-border: #222222;
  --accent: #fbbf24;
  --font-mono: 'JetBrains Mono', 'SF Mono', Monaco, monospace;
}

* { box-sizing: border-box; margin: 0; padding: 0; }

html, body {
  background: var(--bg);
  color: var(--text-dim);
  font-family: var(--font-mono);
  font-size: 15px;
  line-height: 1.7;
  height: 100%;
  overflow: hidden;
  -webkit-font-smoothing: antialiased;
}

#root { height: 100%; }

/* =============================================
   TELEPROMPTER CONTAINER
   ============================================= */
.teleprompter {
  position: relative;
  height: 100vh;
  width: 100vw;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.teleprompter-header {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  padding: 24px 48px;
  background: linear-gradient(to bottom, rgba(0,0,0,1) 0%, rgba(0,0,0,0.95) 60%, rgba(0,0,0,0) 100%);
  z-index: 50;
  display: flex;
  align-items: center;
  gap: 16px;
}

.lesson-number {
  font-size: 11px;
  font-weight: 500;
  letter-spacing: 0.15em;
  color: var(--accent);
  background: rgba(251, 191, 36, 0.1);
  padding: 4px 10px;
  border-radius: 4px;
  text-transform: uppercase;
}

.lesson-title {
  font-size: 14px;
  font-weight: 500;
  letter-spacing: 0.05em;
  color: var(--text-dim);
}

/* =============================================
   TWO-COLUMN LAYOUT
   ============================================= */
.teleprompter-columns {
  flex: 1;
  display: grid;
  grid-template-columns: 45fr 55fr;
  gap: 0;
  overflow: hidden;
}

/* =============================================
   TELEPROMPTER CONTENT - Scrolling area with mask
   ============================================= */
.teleprompter-content {
  overflow-y: auto;
  scroll-behavior: smooth;
  scroll-snap-type: y mandatory;
  padding: 30vh 0;
  border-right: 1px solid var(--border);

  /* Critical: mask-image for fade effect at edges */
  mask-image: linear-gradient(
    to bottom,
    transparent 0%,
    black 15%,
    black 85%,
    transparent 100%
  );
  -webkit-mask-image: linear-gradient(
    to bottom,
    transparent 0%,
    black 15%,
    black 85%,
    transparent 100%
  );
}

/* =============================================
   PARAGRAPH STYLING
   ============================================= */
.teleprompter-paragraph {
  max-width: 580px;
  margin: 0 auto;
  padding: 40px 48px;
  scroll-snap-align: center;
  scroll-snap-stop: always;
  transition: opacity 0.5s ease, transform 0.4s ease, filter 0.5s ease;
  min-height: 20vh;
  display: flex;
  flex-wrap: wrap;
  align-items: flex-start;
  align-content: center;
}

/* Paragraph states */
.teleprompter-paragraph.future {
  opacity: 0.3;
  filter: blur(2px);
  transform: translateY(20px) scale(0.98);
}

.teleprompter-paragraph.current {
  opacity: 1;
  filter: blur(0);
  transform: translateY(0) scale(1);
}

.teleprompter-paragraph.past {
  opacity: 0.5;
  filter: blur(0);
  transform: translateY(-10px) scale(0.99);
}

/* Paragraph type indicators */
.teleprompter-paragraph[data-type="intro"]::before {
  content: '';
  display: block;
  width: 100%;
  height: 2px;
  background: linear-gradient(to right, var(--accent), transparent);
  margin-bottom: 24px;
}

.teleprompter-paragraph[data-type="takeaway"] {
  border-left: 2px solid var(--accent);
  padding-left: 32px;
  margin-left: 16px;
}

.teleprompter-paragraph[data-type="example"] {
  background: rgba(251, 191, 36, 0.03);
  border-radius: 8px;
}

.teleprompter-paragraph[data-type="list"] {
  padding-left: 24px;
}

/* =============================================
   WORD STYLING
   ============================================= */
.word {
  display: inline;
  transition: color 0.1s ease, background 0.1s ease, box-shadow 0.15s ease;
  padding: 1px 0;
}

/* Current word - white background with subtle amber glow */
.word.current {
  background: var(--highlight-bg);
  color: var(--highlight-text);
  padding: 2px 6px;
  margin: 0 2px;
  border-radius: 3px;
  box-shadow: 0 0 12px var(--highlight-glow), 0 0 24px rgba(251, 191, 36, 0.1);
}

/* Already read - stays BRIGHT WHITE */
.word.past {
  color: var(--text-read);
}

/* Not yet read - dim */
.word.future {
  color: var(--text-dim);
}

/* Keyword styling */
.word.keyword {
  font-weight: 500;
}

.word.keyword.current {
  background: var(--accent);
  color: #000;
  box-shadow: 0 0 25px var(--highlight-glow), 0 0 50px rgba(251, 191, 36, 0.2);
}

.word.keyword.past {
  color: var(--accent);
}

/* =============================================
   PROGRESS BAR
   ============================================= */
.teleprompter-progress {
  position: fixed;
  top: 0;
  left: 0;
  height: 2px;
  width: var(--progress, 0%);
  background: var(--accent);
  transition: width 0.15s linear;
  z-index: 100;
}

/* =============================================
   CONTROLS - Fixed bottom right
   ============================================= */
.controls {
  position: fixed;
  bottom: 32px;
  right: 32px;
  display: flex;
  gap: 8px;
  z-index: 100;
}

.ctrl-btn {
  width: 48px;
  height: 48px;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(8, 8, 8, 0.9);
  border: 1px solid #333;
  border-radius: 12px;
  color: var(--text-dim);
  cursor: pointer;
  transition: all 0.2s ease;
  font-size: 18px;
  backdrop-filter: blur(10px);
}

.ctrl-btn:hover {
  background: rgba(20, 20, 20, 0.95);
  color: #fff;
  border-color: #555;
  transform: translateY(-2px);
}

.ctrl-btn:active {
  transform: translateY(0);
}

.ctrl-btn.playing {
  background: var(--accent);
  color: #000;
  border-color: var(--accent);
}

.ctrl-btn.playing:hover {
  background: #fcd34d;
}

/* =============================================
   LESSON SELECTOR - Top right
   ============================================= */
.lesson-selector {
  position: fixed;
  top: 24px;
  right: 32px;
  z-index: 100;
}

.lesson-dropdown {
  padding: 10px 16px;
  font-size: 12px;
  font-family: var(--font-mono);
  background: rgba(8, 8, 8, 0.9);
  border: 1px solid #333;
  color: #888;
  border-radius: 8px;
  cursor: pointer;
  outline: none;
  backdrop-filter: blur(10px);
  transition: all 0.2s ease;
}

.lesson-dropdown:hover {
  border-color: #555;
  color: #fff;
}

.lesson-dropdown:focus {
  border-color: var(--accent);
}

.lesson-dropdown option {
  background: #0a0a0a;
  padding: 8px;
}

/* =============================================
   SPEED & STATUS INDICATOR
   ============================================= */
.status-indicator {
  position: fixed;
  bottom: 32px;
  left: 32px;
  display: flex;
  flex-direction: column;
  gap: 4px;
  font-size: 11px;
  color: var(--text-very-dim);
  z-index: 100;
}

.status-indicator .speed {
  color: var(--text-dim);
}

.status-indicator .progress-text {
  color: var(--accent);
  opacity: 0.7;
}

/* =============================================
   KEYBOARD HINTS
   ============================================= */
.keyboard-hints {
  position: fixed;
  bottom: 32px;
  left: 50%;
  transform: translateX(-50%);
  display: flex;
  gap: 16px;
  font-size: 10px;
  color: var(--text-very-dim);
  z-index: 100;
  opacity: 0;
  transition: opacity 0.3s ease;
}

.teleprompter:hover .keyboard-hints {
  opacity: 1;
}

.keyboard-hint {
  display: flex;
  align-items: center;
  gap: 6px;
}

.key {
  background: #111;
  border: 1px solid #333;
  padding: 2px 8px;
  border-radius: 4px;
  font-family: var(--font-mono);
}

/* =============================================
   SECTION HEADER - Kit Langton style
   ============================================= */
.section-header {
  width: 100%;
  max-width: 580px;
  margin: 80px auto 32px auto;
  padding: 0 48px 12px 48px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-bottom: 1px solid rgba(251, 191, 36, 0.12);
  transition: opacity 0.5s ease, border-color 0.3s ease;
  position: relative;
}

/* Diagonal stripe divider below section header */
.section-header::after {
  content: '';
  position: absolute;
  left: 48px;
  right: 48px;
  bottom: -16px;
  height: 12px;
  background-image: repeating-linear-gradient(
    -45deg,
    transparent,
    transparent 3px,
    rgba(251, 191, 36, 0.06) 3px,
    rgba(251, 191, 36, 0.06) 4px
  );
  opacity: 1;
  transition: opacity 0.3s ease;
}

.section-header.completed {
  opacity: 0.4;
  border-color: rgba(251, 191, 36, 0.05);
}

.section-header.completed::after {
  opacity: 0.3;
}

.section-header.current {
  opacity: 1;
  border-color: rgba(251, 191, 36, 0.25);
}

.section-title {
  font-size: 10px;
  font-weight: 600;
  letter-spacing: 0.2em;
  text-transform: uppercase;
  color: var(--accent);
  font-family: var(--font-mono);
}

.section-header.completed .section-title {
  color: rgba(251, 191, 36, 0.5);
}

.section-progress {
  font-size: 8px;
  letter-spacing: 0.15em;
  color: var(--accent);
  font-family: var(--font-mono);
  opacity: 0.6;
  line-height: 1;
}

.section-header.completed .section-progress {
  opacity: 0.25;
}

/* First section header - less top margin */
.section-header:first-child {
  margin-top: 24px;
}

/* =============================================
   SCROLLBAR - Minimal
   ============================================= */
.teleprompter-content::-webkit-scrollbar {
  width: 4px;
}

.teleprompter-content::-webkit-scrollbar-track {
  background: transparent;
}

.teleprompter-content::-webkit-scrollbar-thumb {
  background: #222;
  border-radius: 2px;
}

.teleprompter-content::-webkit-scrollbar-thumb:hover {
  background: #333;
}

/* =============================================
   ANIMATIONS
   ============================================= */
@keyframes pulse-glow {
  0%, 100% {
    box-shadow: 0 0 12px var(--highlight-glow), 0 0 24px rgba(251, 191, 36, 0.1);
  }
  50% {
    box-shadow: 0 0 16px var(--highlight-glow), 0 0 32px rgba(251, 191, 36, 0.15);
  }
}

.word.current {
  animation: pulse-glow 2s ease-in-out infinite;
}

/* =============================================
   VISUALIZATION PANEL
   ============================================= */
.visualization-panel {
  position: relative;
  overflow: hidden;
  background: #0a0a0a;
}

.visualization-content {
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 48px;
}

.visualization-placeholder {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 24px;
  text-align: center;
  width: 100%;
  max-width: 500px;
  padding: 48px;
  border: 2px solid var(--card-border);
  border-radius: 12px;
  background: rgba(0, 0, 0, 0.4);
  backdrop-filter: blur(10px);
  transition: all 0.3s ease;
}

.visualization-placeholder:hover {
  border-color: #333;
  background: rgba(0, 0, 0, 0.6);
}

.visualization-icon {
  color: var(--text-very-dim);
  opacity: 0.6;
  transition: all 0.3s ease;
}

.visualization-placeholder:hover .visualization-icon {
  color: var(--text-dim);
  opacity: 0.8;
}

.visualization-label {
  font-size: 13px;
  font-weight: 600;
  letter-spacing: 0.1em;
  color: var(--accent);
  text-transform: uppercase;
  line-height: 1.4;
}

.visualization-meta {
  font-size: 11px;
  color: var(--text-very-dim);
  letter-spacing: 0.05em;
}

/* =============================================
   RESPONSIVE
   ============================================= */
@media (max-width: 768px) {
  .teleprompter-columns {
    grid-template-columns: 1fr;
  }

  .visualization-panel {
    display: none;
  }

  .teleprompter-content {
    border-right: none;
  }

  .teleprompter-paragraph {
    padding: 32px 24px;
    max-width: 100%;
  }

  html, body {
    font-size: 15px;
  }

  .controls {
    bottom: 16px;
    right: 16px;
  }

  .ctrl-btn {
    width: 42px;
    height: 42px;
  }

  .lesson-selector {
    top: 16px;
    right: 16px;
  }

  .status-indicator {
    bottom: 16px;
    left: 16px;
  }

  .section-header {
    padding: 0 24px 12px 24px;
    margin: 48px auto 24px auto;
  }

  .section-header::after {
    left: 24px;
    right: 24px;
  }

  .section-title {
    font-size: 10px;
    letter-spacing: 0.15em;
  }

  .section-progress {
    font-size: 9px;
  }
}
