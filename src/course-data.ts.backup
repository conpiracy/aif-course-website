/**
 * AIF Course Data - Full Content
 * Structured for teleprompter-style presentation
 */

export interface Paragraph {
  id: string;
  text: string;
  type: 'intro' | 'concept' | 'example' | 'list' | 'takeaway';
}

export interface Section {
  id: string;
  title: string;
  paragraphs: Paragraph[];
}

export interface Lesson {
  id: string;
  title: string;
  sections: Section[];
  keywords: string[];
}

export interface Module {
  id: string;
  title: string;
  lessons: Lesson[];
}

// Helper to split content into sections with paragraphs
function parseContent(content: string, lessonId: string, sectionTitles: string[]): Section[] {
  const blocks = content.split('\n\n').filter(b => b.trim());
  const sections: Section[] = [];
  let currentSection: Section | null = null;
  let paragraphIndex = 0;

  // Calculate paragraphs per section (distribute evenly)
  const paragraphsPerSection = Math.ceil(blocks.length / sectionTitles.length);
  let sectionIndex = 0;

  blocks.forEach((block, idx) => {
    // Start a new section if needed
    if (idx % paragraphsPerSection === 0 && sectionIndex < sectionTitles.length) {
      if (currentSection) {
        sections.push(currentSection);
      }
      currentSection = {
        id: `${lessonId}-s${sectionIndex}`,
        title: sectionTitles[sectionIndex],
        paragraphs: []
      };
      sectionIndex++;
    }

    const trimmed = block.trim();
    let type: Paragraph['type'] = 'concept';

    // Determine type based on content patterns
    if (idx === 0) type = 'intro';
    else if (trimmed.startsWith('-') || trimmed.includes('\n-')) type = 'list';
    else if (trimmed.toLowerCase().includes('example:') || trimmed.includes('Example:')) type = 'example';
    else if (trimmed.toLowerCase().includes('outcome') || trimmed.toLowerCase().includes('takeaway')) type = 'takeaway';

    if (currentSection) {
      currentSection.paragraphs.push({
        id: `${lessonId}-p${paragraphIndex}`,
        text: trimmed,
        type
      });
    }
    paragraphIndex++;
  });

  // Push the last section
  if (currentSection) {
    sections.push(currentSection);
  }

  return sections;
}

